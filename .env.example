# Run npm run configure to generate fresh keys and demo client secrets.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/proofgate?schema=public
WALLET_ORIGIN=http://localhost:5174
GATEWAY_ORIGIN=http://localhost:4000
PORT=4000
NODE_ENV=development
DATA_KEY=
ISSUER_PRIVATE_KEY=
PAIRWISE_KEY=
DEMO_AGE_SECRET=
DEMO_EMAIL_SECRET=
DEMO_STUDENT_SECRET=
PRIVATE_STORAGE=./private/documents
# Optional SMTP. Without it email remains UNVERIFIED; demo credentials say so.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional ClamAV clamscan executable path; production requires a scanner.
CLAMSCAN_PATH=
