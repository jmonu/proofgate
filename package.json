{
  "name": "proofgate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:backend": "tsx watch backend/src/index.ts",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "dev:demos": "tsx demo-sites/server.ts",
    "configure": "tsx scripts/configure.ts",
    "db:init": "tsx scripts/db-init.ts",
    "db:generate": "prisma generate --schema database/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema database/schema.prisma",
    "db:seed": "tsx scripts/seed.ts",
    "crypto:build": "node scripts/build-crypto.mjs",
    "check": "tsc --noEmit",
    "build": "npm run check && vite build --config frontend/vite.config.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "doctor": "tsx scripts/doctor.ts",
    "cleanup": "tsx scripts/cleanup.ts",
    "test:db": "tsx scripts/test-database.ts",
    "test:db:stop": "tsx scripts/test-database.ts --stop"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "argon2": "^0.44.0",
    "circomlibjs": "^0.1.7",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "file-type": "^21.1.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.1.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "snarkjs": "^0.7.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^7.0.3",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.1.0",
    "circomlib": "^2.0.5",
    "prettier": "^3.9.10",
    "prisma": "^6.19.0",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "underscore": "^1.13.8",
    "ws": "^8.21.0"
  },
  "optionalDependencies": {
    "@embedded-postgres/windows-x64": "^18.4.0-beta.17"
  }
}
